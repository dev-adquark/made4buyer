{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "regions": [
    "syd1"
  ],
  "crons": [
    {
      "path": "/api/cron/scrape-sources",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/collect-scrapes",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/cron/cleanup-cache",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/inspect-index",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/retry-failed",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/publish-cycle",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/detect-stale",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/enrich-images",
      "schedule": "55 9 * * *"
    },
    {
      "path": "/api/cron/daily-article?slot=morning",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/daily-article?slot=evening",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/enrich-products",
      "schedule": "50 7 * * *"
    },
    {
      "path": "/api/cron/fix-title-years",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/cron/commerce-discover",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/commerce-collect",
      "schedule": "40 10 * * *"
    },
    {
      "path": "/api/cron/commerce-coupons",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/cron/data-audit",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/commerce-validate-links",
      "schedule": "10 12 * * *"
    },
    {
      "path": "/api/cron/commerce-official-verify",
      "schedule": "40 12 * * *"
    }
  ]
}
