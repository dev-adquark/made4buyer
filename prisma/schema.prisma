generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Review {
  id String @id @default(cuid())
  sourceId String @unique
  title String
  slug String @unique
  summary String
  body String
  productName String?
  brand String?
  category String
  subcategory String?
  audience String?
  platform String?
  priceTier String?
  imageUrl String?
  imageSource String?
  imageLicense String?
  imageAttribution String?
  sourceUrl String?
  canonicalUrl String? @unique
  status ReviewStatus @default(DRAFT)
  confidence Float @default(0)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals Deal[]
  events AnalyticsEvent[]
  @@index([status,publishedAt])
  @@index([category,status,publishedAt])
  @@index([canonicalUrl])
}

model Deal {
  id String @id @default(cuid())
  reviewId String
  productName String
  merchant String?
  dealId String?
  url String
  price Float?
  currency String?
  availability String?
  verified Boolean @default(false)
  lastChecked DateTime?
  createdAt DateTime @default(now())
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  @@index([reviewId,verified])
  @@index([verified,lastChecked])
}

model IngestionRun {
  id String @id @default(cuid())
  startedAt DateTime @default(now())
  finishedAt DateTime?
  source String
  status String
  total Int @default(0)
  accepted Int @default(0)
  rejected Int @default(0)
  duplicate Int @default(0)
  errors Json?
  lockKey String? @unique
  @@index([startedAt])
}

model SponsoredPlacement {
  id String @id @default(cuid())
  title String
  label String @default("Sponsored")
  url String
  active Boolean @default(false)
  minEvents Int @default(100)
  minSessions Int @default(25)
  startAt DateTime?
  endAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active,startAt,endAt])
}

model AnalyticsEvent {
  id String @id @default(cuid())
  reviewId String?
  event String
  category String?
  sessionId String?
  metadata Json?
  createdAt DateTime @default(now())
  review Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  @@index([event,createdAt])
  @@index([sessionId,createdAt])
  @@index([reviewId,createdAt])
  @@index([category,createdAt])
}

enum ReviewStatus {
  DRAFT
  QUEUED
  PUBLISHED
  REJECTED
}
