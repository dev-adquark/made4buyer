// Made4Buyers — RealTech Review Engine
// Data flow: Content API → ContentItem → NormalizedReview → ExtractedEntities → CategoryTagSet
// (ReviewCategoryAssignment) → ImageAsset → MatchedSovrnOfferSet (SovrnOfferMatch) → AffiliateLinkSet
// (AffiliateLink) → PageRenderModel → PublishJob. See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: runtime connection (Supabase transaction pooler, port 6543, pgbouncer=true).
// DIRECT_URL:   migrations (Supabase session pooler, port 5432) — prepared statements and DDL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum RunStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  SKIPPED

  @@map("run_status")
}

enum ContentProcessingStatus {
  INGESTED
  NORMALIZED
  DUPLICATE
  FAILED
  QUEUED
  PUBLISHED
  REJECTED

  @@map("content_processing_status")
}

enum ReviewStatus {
  NEEDS_REVIEW
  QUEUED
  PUBLISHED
  UNPUBLISHED
  REJECTED

  @@map("review_status")
}

enum ContentKind {
  REVIEW
  AI_GUIDE
  /// "A vs B (vs C...)" articles: several products, no single product name.
  COMPARISON
  /// "Best X", "X buying guide", "X alternatives" articles from a source publisher.
  BUYING_GUIDE

  @@map("content_kind")
}

enum TagType {
  CATEGORY
  SUBCATEGORY
  INTENT
  PLATFORM
  PRICE_TIER

  @@map("tag_type")
}

enum AssignmentSource {
  RULES
  SOURCE_FIELD
  ADMIN
  CSV

  @@map("assignment_source")
}

enum AssignmentReviewState {
  UNREVIEWED
  ACCEPTED
  REJECTED

  @@map("assignment_review_state")
}

enum DealStatus {
  PENDING
  MATCHED
  NO_MATCH
  STALE
  FAILED
  UNAVAILABLE

  @@map("deal_status")
}

enum OfferMatchStatus {
  MATCHED
  BELOW_THRESHOLD
  STALE
  SUPERSEDED

  @@map("offer_match_status")
}

enum LinkGenerationMethod {
  PROVIDER_DEEPLINK
  LINK_WRAPPER

  @@map("link_generation_method")
}

enum LinkVerificationStatus {
  PENDING
  VERIFIED_OK
  REDIRECT_MISMATCH
  FORBIDDEN
  BLOCKED
  UNAVAILABLE
  TIMEOUT
  INVALID
  PROVIDER_ERROR

  @@map("link_verification_status")
}

enum ImageSourceType {
  CONTENT_API
  ENRICHMENT_SERVICE
  PLACEHOLDER
  /// A freely licensed photo of the exact product on Wikimedia Commons (via Wikidata P18).
  WIKIMEDIA_COMMONS

  @@map("image_source_type")
}

enum LicenseState {
  VERIFIED
  PROVIDER_ASSERTED
  UNVERIFIED
  OWNED_PLACEHOLDER

  @@map("license_state")
}

enum EnrichmentStatus {
  ENRICHED
  FALLBACK
  FAILED

  @@map("enrichment_status")
}

enum PublishAction {
  PUBLISH
  UNPUBLISH

  @@map("publish_action")
}

enum PublishJobStatus {
  SUCCEEDED
  FAILED

  @@map("publish_job_status")
}

enum CsvJobStatus {
  VALIDATED
  REJECTED
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS

  @@map("csv_job_status")
}

enum CsvItemStatus {
  PENDING
  INVALID
  PROCESSING
  APPLIED
  FAILED

  @@map("csv_item_status")
}

enum PipelineStage {
  CONTENT_FETCH
  VALIDATION
  NORMALIZATION
  DEDUPE
  ENTITY_EXTRACTION
  TAXONOMY
  IMAGE_ENRICHMENT
  OFFER_MATCHING
  AFFILIATE_LINK
  LINK_VERIFICATION
  PAGE_RENDER
  PUBLISH
  CSV_IMPORT
  REVALIDATION
  INDEX_INSPECTION

  @@map("pipeline_stage")
}

enum FailureKind {
  RETRYABLE_FAILURE
  PERMANENT_FAILURE

  @@map("failure_kind")
}

enum RevalidationType {
  OFFER_REFRESH
  LINK_VERIFICATION
  CACHE_CLEANUP
  FAILED_RETRY
  PUBLISH_CYCLE
  INDEX_INSPECTION
  COUPON_REFRESH
  PRODUCT_ENRICHMENT

  @@map("revalidation_type")
}

enum SponsoredPosition {
  HOME_HERO
  CATEGORY_TOP
  REVIEW_SIDEBAR

  @@map("sponsored_position")
}

enum IndexVerdict {
  INDEXED
  NOT_INDEXED
  UNKNOWN
  ERROR

  @@map("index_verdict")
}

// ─── Ingestion ──────────────────────────────────────────────────────────────

model IngestionRun {
  id                       String        @id @default(cuid())
  startedAt                DateTime      @default(now())
  completedAt              DateTime?
  status                   RunStatus     @default(RUNNING)
  source                   String
  trigger                  String        @default("manual")
  totalFetched             Int           @default(0)
  normalizedCount          Int           @default(0)
  duplicateCount           Int           @default(0)
  unchangedCount           Int           @default(0)
  updatedCount             Int           @default(0)
  failedNormalizationCount Int           @default(0)
  queuedCount              Int           @default(0)
  failureCount             Int           @default(0)
  failureReasonSummary     Json?
  duplicateItems           Json?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  contentItems             ContentItem[]

  @@index([startedAt])
  @@index([status])
  @@map("review_ingest_runs")
}

model ContentItem {
  id                 String                  @id @default(cuid())
  source             String
  sourceId           String
  sourceUrl          String?
  rawPayload         Json
  contentHash        String
  publishedAt        DateTime?
  fetchedAt          DateTime                @default(now())
  lastSeenAt         DateTime                @default(now())
  processingStatus   ContentProcessingStatus @default(INGESTED)
  statusReason       String?
  errorCode          String?
  retryCount         Int                     @default(0)
  dedupeKey          String?
  ingestRunId        String?
  normalizedReviewId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  ingestRun          IngestionRun?           @relation(fields: [ingestRunId], references: [id], onDelete: SetNull)
  normalizedReview   NormalizedReview?       @relation("ContentItemReview", fields: [normalizedReviewId], references: [id], onDelete: SetNull)

  /// External-content freshness (source dates only; crawl/ingest dates never count).
  sourceUpdatedAt    DateTime?
  /// FRESH | STALE | UNKNOWN | INVALID_DATE (null for generated content, which is exempt)
  freshnessStatus    String?
  freshnessAgeDays   Int?
  freshnessCheckedAt DateTime?

  @@unique([source, sourceId])
  @@index([processingStatus])
  @@index([contentHash])
  @@index([normalizedReviewId])
  @@index([ingestRunId])
  @@index([createdAt])
  @@map("content_items")
}

// ─── Reviews ────────────────────────────────────────────────────────────────

model NormalizedReview {
  id                       String                     @id @default(cuid())
  source                   String
  sourceId                 String
  sourceUrl                String?
  canonicalUrl             String?
  dedupeKey                String                     @unique
  canonicalTitle           String
  kind                     ContentKind                @default(REVIEW)
  generationMeta           Json?
  editorApprovedAt         DateTime?
  editorApprovedBy         String?
  slug                     String                     @unique
  productName              String
  brand                    String?
  brandSlug                String?
  summary                  String
  body                     String
  author                   String?
  sourcePublishedAt        DateTime?
  entityConfidence         Float                      @default(0)
  classificationConfidence Float                      @default(0)
  confidence               Float                      @default(0)
  categorySlug             String?
  subcategorySlug          String?
  status                   ReviewStatus               @default(NEEDS_REVIEW)
  statusReason             String?
  qaFailures               Json?
  manualEditLocked         Boolean                    @default(false)
  dealStatus               DealStatus                 @default(PENDING)
  dealStatusReason         String?
  dealCheckedAt            DateTime?
  sovrnDealIdOverride      String?
  publishedAt              DateTime?
  unpublishedAt            DateTime?
  rejectedAt               DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  contentItems             ContentItem[]              @relation("ContentItemReview")
  entities                 ExtractedEntities?
  assignments              ReviewCategoryAssignment[]
  offerMatches             SovrnOfferMatch[]
  affiliateLinks           AffiliateLink[]
  coupons                  SovrnCoupon[]
  /// Commerce data the SOURCE page published (provenance: source page + observation time).
  /// Never presented as a live price; the verified-offer pipeline stays the only "deal" source.
  sourceProductUrl         String?
  sourcePrice              Float?
  sourceCurrency           String?
  sourceAvailability       String?
  sourcePriceObservedAt    DateTime?
  /// Extra normalized source data (pros, cons, specs, breadcrumbs, images, identifiers …); null when absent.
  sourceData               Json?
  images                   ImageAsset[]
  contentEntities          ContentEntity[]
  renderModel              PageRenderModel?
  publishJobs              PublishJob[]
  events                   AnalyticsEvent[]
  csvItems                 CsvImportItem[]
  indexChecks              SearchIndexCheck[]

  sourceUpdatedAt DateTime?
  freshnessStatus String?

  @@unique([source, sourceId])
  @@index([status, publishedAt])
  @@index([kind, status])
  @@index([categorySlug, status, publishedAt])
  @@index([brandSlug, status])
  @@index([confidence])
  @@index([dealStatus])
  @@index([canonicalUrl])
  @@index([createdAt])
  @@map("normalized_reviews")
}

model ExtractedEntities {
  id                  String           @id @default(cuid())
  normalizedReviewId  String           @unique
  productName         String
  brand               String?
  deviceType          String?
  useCase             String?
  platform            String?
  price               Float?
  currency            String?
  modelNumber         String?
  source              String
  publishDate         DateTime?
  rating              Float?
  ratingScale         Float?
  confidences         Json
  overrides           Json?
  lowConfidenceFields String[]         @default([])
  overallConfidence   Float
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  review              NormalizedReview @relation(fields: [normalizedReviewId], references: [id], onDelete: Cascade)

  @@index([overallConfidence])
  @@map("extracted_entities")
}

// ─── Taxonomy ───────────────────────────────────────────────────────────────

model CategoryTag {
  id          String                     @id @default(cuid())
  type        TagType
  slug        String
  name        String
  description String?
  parentId    String?
  sortOrder   Int                        @default(0)
  active      Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  parent      CategoryTag?               @relation("TagParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    CategoryTag[]              @relation("TagParent")
  assignments ReviewCategoryAssignment[]

  @@unique([type, slug])
  @@index([type, active])
  @@map("category_tags")
}

model ReviewCategoryAssignment {
  id                 String                @id @default(cuid())
  normalizedReviewId String
  categoryTagId      String
  tagType            TagType
  confidence         Float
  reason             String
  source             AssignmentSource
  isPrimary          Boolean               @default(false)
  isOverride         Boolean               @default(false)
  overrideSource     String?
  active             Boolean               @default(true)
  reviewState        AssignmentReviewState @default(UNREVIEWED)
  reviewedAt         DateTime?
  reviewedBy         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  review             NormalizedReview      @relation(fields: [normalizedReviewId], references: [id], onDelete: Cascade)
  categoryTag        CategoryTag           @relation(fields: [categoryTagId], references: [id], onDelete: Restrict)

  @@index([normalizedReviewId, active])
  @@index([categoryTagId, active])
  @@index([tagType, active, confidence])
  @@index([reviewState])
  @@index([createdAt])
  @@map("review_category_assignments")
}

// ─── Sovrn ──────────────────────────────────────────────────────────────────

model SovrnOfferCache {
  id             String            @id @default(cuid())
  queryKey       String
  requestHash    String            @unique
  fetchedAt      DateTime          @default(now())
  expiresAt      DateTime
  rawResponse    Json?
  providerStatus String
  httpStatus     Int?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  matches        SovrnOfferMatch[]

  @@index([expiresAt])
  @@index([queryKey])
  @@map("sovrn_offers_cache")
}

model SovrnOfferMatch {
  id                   String           @id @default(cuid())
  normalizedReviewId   String
  cacheId              String?
  offerId              String
  title                String
  merchantName         String?
  merchantId           String?
  offerUrl             String
  providerAffiliateUrl String?
  price                Float?
  currency             String?
  availability         String?
  imageUrl             String?
  score                Float
  scoreBreakdown       Json
  isBestOffer          Boolean          @default(false)
  rank                 Int              @default(0)
  matchStatus          OfferMatchStatus @default(MATCHED)
  selectionReason      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  review               NormalizedReview @relation(fields: [normalizedReviewId], references: [id], onDelete: Cascade)
  cache                SovrnOfferCache? @relation(fields: [cacheId], references: [id], onDelete: SetNull)
  affiliateLinks       AffiliateLink[]

  @@unique([normalizedReviewId, offerId])
  @@index([normalizedReviewId, isBestOffer])
  @@index([matchStatus])
  @@map("sovrn_offer_matches")
}

// ─── Affiliate ──────────────────────────────────────────────────────────────

model AffiliateLink {
  id                   String                 @id @default(cuid())
  normalizedReviewId   String
  offerMatchId         String?
  sovrnOfferId         String
  affiliateUrl         String
  destinationUrl       String?
  generationMethod     LinkGenerationMethod
  isBest               Boolean                @default(false)
  isActive             Boolean                @default(true)
  verificationStatus   LinkVerificationStatus @default(PENDING)
  verificationReason   String?
  httpStatus           Int?
  redirectChain        Json?
  finalUrl             String?
  verificationAttempts Int                    @default(0)
  lastVerifiedAt       DateTime?
  nextVerificationAt   DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  review               NormalizedReview       @relation(fields: [normalizedReviewId], references: [id], onDelete: Cascade)
  offerMatch           SovrnOfferMatch?       @relation(fields: [offerMatchId], references: [id], onDelete: SetNull)

  @@unique([normalizedReviewId, sovrnOfferId])
  @@index([normalizedReviewId, isActive])
  @@index([verificationStatus])
  @@index([nextVerificationAt])
  @@index([lastVerifiedAt])
  @@map("affiliate_links")
}

/// A Sovrn Commerce promo code for a product URL (Product Promo Codes API). Stored only as Sovrn
/// returned it; a code missing from the latest response, or not re-verified recently, is not shown.
model SovrnCoupon {
  id                 String           @id @default(cuid())
  normalizedReviewId String
  productUrl         String
  sovrnCouponId      String
  code               String
  description        String?
  affiliatedUrl      String
  originalPrice      Float?
  priceWithCode      Float?
  currency           String
  verified           Boolean
  verifiedAt         DateTime?
  merchantDomain     String?
  merchantName       String?
  rank               Int              @default(0)
  isActive           Boolean          @default(true)
  firstSeenAt        DateTime         @default(now())
  lastSeenAt         DateTime         @default(now())
  nextCheckAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  review             NormalizedReview @relation(fields: [normalizedReviewId], references: [id], onDelete: Cascade)

  @@unique([normalizedReviewId, productUrl, sovrnCouponId])
  @@index([isActive, nextCheckAt])
  @@map("sovrn_coupons")
}

// ─── Images ─────────────────────────────────────────────────────────────────

model ImageAsset {
  id                 String           @id @default(cuid())
  normalizedReviewId String
  sourceType         ImageSourceType
  sourceUrl          String?
  cdnUrl             String?
  contentType        String?
  width              Int?
  height             Int?
  licenseState       LicenseState
  license            String?
  attribution        String?
  attributionUrl     String?
  enrichmentStatus   EnrichmentStatus
  isFallback         Boolean          @default(false)
  isPrimary          Boolean          @default(true)
  failureReason      String?
  /// PRODUCT (the photo shows the reviewed product) or ILLUSTRATIVE (a topic photo, labelled as such).
  subject            String?
  /// Provider-scoped photo id, e.g. "pexels:12345", used to avoid reusing one photo across reviews.
  providerPhotoId    String?
  searchQuery        String?
  altText            String?
  photographerUrl    String?
  verifiedAt         DateTime?
  /// What the image shows and how we know: official-product | retailer-product | commons-product |
  /// source-product | illustrative-category | neutral-category (lib/images/provenance.ts).
  imageType          String?
  /// How sure we are the image shows this content's product (0..1); null for category images.
  matchConfidence    Float?
  /// The page the image is described on / taken from (e.g. its Wikimedia Commons file page).
  sourcePageUrl      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  review             NormalizedReview @relation(fields: [normalizedReviewId], references: [id], onDelete: Cascade)

  @@index([normalizedReviewId, isPrimary])
  @@index([providerPhotoId])
  @@index([enrichmentStatus])
  @@index([licenseState])
  @@index([imageType])
  @@map("image_assets")
}

// ─── Rendering / publishing ─────────────────────────────────────────────────

model PageRenderModel {
  id                 String           @id @default(cuid())
  normalizedReviewId String           @unique
  model              Json
  modelHash          String
  version            Int              @default(1)
  builtAt            DateTime         @default(now())
  review             NormalizedReview @relation(fields: [normalizedReviewId], references: [id], onDelete: Cascade)

  @@map("page_render_models")
}

model PublishJob {
  id                 String           @id @default(cuid())
  normalizedReviewId String
  action             PublishAction
  status             PublishJobStatus
  trigger            String
  actor              String?
  qaFailures         Json?
  errorCode          String?
  message            String?
  createdAt          DateTime         @default(now())
  review             NormalizedReview @relation(fields: [normalizedReviewId], references: [id], onDelete: Cascade)

  @@index([normalizedReviewId, createdAt])
  @@index([status, createdAt])
  @@map("publish_jobs")
}

model RevalidationRun {
  id              String           @id @default(cuid())
  type            RevalidationType
  status          RunStatus        @default(RUNNING)
  trigger         String
  actor           String?
  rangeStart      DateTime?
  rangeEnd        DateTime?
  checkedCount    Int              @default(0)
  successCount    Int              @default(0)
  failureCount    Int              @default(0)
  reasonBreakdown Json?
  errorMessage    String?
  startedAt       DateTime         @default(now())
  completedAt     DateTime?

  @@index([type, startedAt])
  @@map("revalidation_runs")
}

// ─── Failures / locks ───────────────────────────────────────────────────────

model PipelineFailure {
  id                 String        @id @default(cuid())
  fingerprint        String        @unique
  stage              PipelineStage
  kind               FailureKind
  errorCode          String
  message            String
  entityType         String
  entityId           String
  contentItemId      String?
  normalizedReviewId String?
  runId              String?
  retryCount         Int           @default(0)
  maxRetries         Int           @default(5)
  nextRetryAt        DateTime?
  resolvedAt         DateTime?
  occurrences        Int           @default(1)
  lastOccurredAt     DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([stage, errorCode])
  @@index([resolvedAt, kind, nextRetryAt])
  @@index([normalizedReviewId])
  @@index([lastOccurredAt])
  @@map("pipeline_failures")
}

model JobLock {
  name      String   @id
  owner     String
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@map("job_locks")
}

/// One execution of a scheduled job (cron, GitHub Actions or Admin "Run now"), written by runJob.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  /// "cron", "admin:<email>", "test" …
  trigger    String
  /// RUNNING | SUCCEEDED | SKIPPED | PAUSED | FAILED | LOCK_HELD
  status     String    @default("RUNNING")
  /// The job's own result status (OK, NOT_DUE, NOT_CONFIGURED …), when it returned one.
  outcome    String?
  reason     String?
  /// Error summary (redacted, truncated) for FAILED runs.
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  @@index([job, startedAt])
  @@index([status, startedAt])
  @@map("job_runs")
}

// ─── Analytics / sponsored / indexing ───────────────────────────────────────

model AnalyticsEvent {
  id                 String            @id @default(cuid())
  event              String
  normalizedReviewId String?
  categorySlug       String?
  sessionId          String?
  path               String?
  metadata           Json?
  createdAt          DateTime          @default(now())
  review             NormalizedReview? @relation(fields: [normalizedReviewId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([categorySlug, event, createdAt])
  @@index([normalizedReviewId, createdAt])
  @@index([sessionId, createdAt])
  @@map("analytics_events")
}

model SponsoredPlacement {
  id                  String            @id @default(cuid())
  title               String
  advertiser          String
  url                 String
  label               String            @default("Sponsored")
  disclosure          String
  categorySlug        String?
  position            SponsoredPosition
  enabled             Boolean           @default(false)
  startAt             DateTime?
  endAt               DateTime?
  minMonthlyPageViews Int               @default(1000)
  minMonthlySessions  Int               @default(250)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([enabled, position, categorySlug])
  @@map("sponsored_placements")
}

model SearchIndexCheck {
  id                 String            @id @default(cuid())
  normalizedReviewId String?
  url                String
  verdict            IndexVerdict
  coverageState      String?
  lastCrawlTime      DateTime?
  error              String?
  checkedAt          DateTime          @default(now())
  review             NormalizedReview? @relation(fields: [normalizedReviewId], references: [id], onDelete: SetNull)

  @@index([url, checkedAt])
  @@index([checkedAt])
  @@map("search_index_checks")
}

// ─── CSV import ─────────────────────────────────────────────────────────────

model CsvImportJob {
  id           String          @id @default(cuid())
  fileName     String
  fileSize     Int
  rowCount     Int             @default(0)
  status       CsvJobStatus
  headerErrors Json?
  validRows    Int             @default(0)
  invalidRows  Int             @default(0)
  appliedRows  Int             @default(0)
  failedRows   Int             @default(0)
  uploadedBy   String
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        CsvImportItem[]

  @@index([createdAt])
  @@map("csv_import_jobs")
}

model CsvImportItem {
  id                        String            @id @default(cuid())
  importJobId               String
  rowNumber                 Int
  normalizedReviewKey       String
  normalizedReviewId        String?
  overridePrimaryCategory   String?
  entityBrandOverride       String?
  entityProductNameOverride String?
  sovrnDealIdOverride       String?
  extraOverrides            Json?
  processingStatus          CsvItemStatus     @default(PENDING)
  errorCode                 String?
  errorReason               String?
  retryCount                Int               @default(0)
  processedAt               DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  job                       CsvImportJob      @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  review                    NormalizedReview? @relation(fields: [normalizedReviewId], references: [id], onDelete: SetNull)

  @@unique([importJobId, rowNumber])
  @@index([processingStatus])
  @@index([normalizedReviewId])
  @@map("csv_import_queue")
}

// ─── Admin / audit / reports ────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminSession {
  id         String    @id
  email      String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("admin_sessions")
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int

  @@map("rate_limit_buckets")
}

model Day30Report {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  generatedAt DateTime @default(now())
  generatedBy String
  json        Json
  html        String

  @@index([generatedAt])
  @@map("day30_reports")
}

// ─── Editorial review sources (Apify Web Scraper) ──────────────────────────

/// Whether we may republish a source's full text. Scraped sources default to EXCERPT_ONLY:
/// the text is used for extraction and filing, the public page shows a summary and links out.
enum ContentRights {
  LICENSED
  EXCERPT_ONLY

  @@map("content_rights")
}

model ReviewSource {
  id                  String        @id @default(cuid())
  slug                String        @unique
  name                String
  homepageUrl         String
  allowedDomains      String[]
  startUrls           String[]
  /// Glob patterns (e.g. https://example.com/reviews/**) that identify individual review pages.
  reviewUrlPatterns   String[]
  categoryHint        String?
  enabled             Boolean       @default(false)
  crawlFrequencyHours Int           @default(24)
  maxPagesPerRun      Int           @default(20)
  rights              ContentRights @default(EXCERPT_ONLY)
  extractionProfile   Json?
  notes               String?
  lastRunAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  runs                ApifyRun[]

  /// Higher runs first. Lowered automatically while unhealthy, restored on recovery.
  priority            Int       @default(100)
  consecutiveFailures Int       @default(0)
  consecutiveStale    Int       @default(0)
  freshCount          Int       @default(0)
  staleCount          Int       @default(0)
  lastFreshAt         DateTime?
  lastStaleAt         DateTime?
  /// Skipped by the scheduler until this time (automatic, recovers on its own).
  pausedUntil         DateTime?
  healthNote          String?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?
  duplicateCount      Int       @default(0)
  errorCount          Int       @default(0)

  @@index([enabled, lastRunAt])
  @@map("review_sources")
}

model ApifyRun {
  id          String       @id @default(cuid())
  sourceId    String
  apifyRunId  String       @unique
  datasetId   String?
  /// Apify status (READY, RUNNING, SUCCEEDED, FAILED, ABORTED, TIMED-OUT) or ours (COLLECTING, COLLECTED, COLLECT_FAILED).
  status      String
  trigger     String
  itemCount   Int?
  accepted    Int?
  rejected    Int?
  ingestRunId String?
  error       String?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  collectedAt DateTime?
  source      ReviewSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  freshCount            Int?
  staleCount            Int?
  unknownFreshnessCount Int?

  @@index([status, startedAt])
  @@index([sourceId, startedAt])
  @@map("apify_runs")
}

// ─── Products / services referenced by content ──────────────────────────────

/// One product or service ("NordVPN", "Cursor"), shared by every review, comparison and guide that covers it.
model ProductEntity {
  id                 String          @id @default(cuid())
  slug               String          @unique
  name               String
  /// Normalised identity: "Nord VPN", "NordVPN" and "nordvpn" share one key.
  matchKey           String          @unique
  aliases            String[]        @default([])
  aliasKeys          String[]        @default([])
  brand              String?
  brandSlug          String?
  categorySlug       String?
  subcategorySlug    String?
  /// Field-level enrichment (see lib/products): resolved snapshot, completeness and last run.
  enrichmentStatus   String?
  enrichedAt         DateTime?
  /// Official-source verification: VERIFIED (found on the brand's official domain, identity matched),
  /// NOT_FOUND, MISMATCH or null (not checked). Only VERIFIED may be labelled official.
  officialStatus     String?
  officialUrl        String?
  officialVerifiedAt DateTime?
  factSummary        Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  content            ContentEntity[]
  facts              ProductFact[]

  @@index([brandSlug])
  @@index([categorySlug])
  @@index([aliasKeys], type: Gin)
  @@map("product_entities")
}

/// One value for one product field as one source stated it (provenance). Never guessed; the
/// resolver (lib/products/facts.ts) chooses per field by authority, identity match and freshness.
model ProductFact {
  id               String        @id @default(cuid())
  productEntityId  String
  field            String
  value            Json
  unit             String?
  source           String
  sourceName       String
  /// sourceUrl, or the source name when there is no URL (unique key part).
  sourceKey        String
  sourceUrl        String?
  observedAt       DateTime
  matchBasis       String
  /// When the value was first seen, last confirmed, how sure the match is (0..1) and how it was read.
  discoveredAt     DateTime?
  verifiedAt       DateTime?
  confidence       Float?
  extractionMethod String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  entity           ProductEntity @relation(fields: [productEntityId], references: [id], onDelete: Cascade)

  @@unique([productEntityId, field, source, sourceKey])
  @@index([productEntityId])
  @@index([field, observedAt])
  @@map("product_facts")
}

/// Content ↔ product link. PRIMARY: the reviewed product; COMPARED: one side of a comparison; MENTIONED: covered in a guide.
model ContentEntity {
  id                 String           @id @default(cuid())
  normalizedReviewId String
  productEntityId    String
  role               String
  position           Int              @default(0)
  confidence         Float
  /// AUTO (pipeline) or ADMIN (editor). Reprocessing replaces AUTO links only.
  source             String
  createdAt          DateTime         @default(now())
  review             NormalizedReview @relation(fields: [normalizedReviewId], references: [id], onDelete: Cascade)
  entity             ProductEntity    @relation(fields: [productEntityId], references: [id], onDelete: Cascade)

  @@unique([normalizedReviewId, productEntityId])
  @@index([productEntityId])
  @@map("content_entities")
}

// ─── Daily article automation ────────────────────────────────────────────────

/// One candidate article topic. `key` is the topic's identity (never generated twice).
/// Status: QUEUED → LOCKED → GENERATING → QA → PUBLISHED, or REJECTED / FAILED / EXHAUSTED.
model ContentQueueItem {
  id                 String    @id @default(cuid())
  key                String    @unique
  topic              String
  keyword            String
  kind               String
  categorySlug       String
  subcategorySlug    String?
  productName        String?
  brand              String?
  priority           Int       @default(0)
  status             String    @default("QUEUED")
  attempts           Int       @default(0)
  lastAttemptAt      DateTime?
  lockedAt           DateTime?
  failureReason      String?
  normalizedReviewId String?
  publishedAt        DateTime?
  /// Keyword schedule: DAILY | TWICE_WEEKLY | WEEKLY | MONTHLY | ONCE (Admin-editable).
  frequency          String    @default("ONCE")
  /// Where the keyword came from: calendar | admin | search-console | import.
  source             String    @default("calendar")
  enabled            Boolean   @default(true)
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  /// Outcome of the last run: PUBLISHED | DUPLICATE | FAILED | SKIPPED (with failureReason).
  lastResult         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, priority])
  @@index([enabled, nextRunAt])
  @@map("content_queue")
}

/// One scheduled publishing slot per day (Asia/Kolkata date): MORNING or EVENING.
model AutomationSlot {
  id                 String    @id @default(cuid())
  day                String
  slot               String
  /// PENDING, RUNNING, PUBLISHED, RETRYING, BLOCKED
  status             String    @default("PENDING")
  attempts           Int       @default(0)
  /// Keyword-to-Blog requests spent on this slot (each one uses plan quota).
  apiCalls           Int       @default(0)
  queueItemId        String?
  normalizedReviewId String?
  lastError          String?
  lastAttemptAt      DateTime?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([day, slot])
  @@map("automation_slots")
}

/// Admin automation switches (key → "on" | "off" | value). Missing keys use the coded default.
model AutomationSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt

  @@map("automation_settings")
}

// ─── Commerce intelligence engine (Apify) ────────────────────────────────────
// Brands and sources are configuration (editable in Admin). Runs record every Apify job.
// Raw records are exactly what Apify returned and are never overwritten. Products, offers and
// coupons are the normalized, provenance-carrying application data.

/// A brand whose official site is crawled for products and promotions (US market).
model CommerceBrand {
  id                   String            @id @default(cuid())
  name                 String
  slug                 String            @unique
  officialDomain       String
  /// Market served, e.g. "US". Says nothing about ownership.
  market               String            @default("US")
  categories           String[]          @default([])
  /// Pages that list products (category pages, sitemaps); discovery starts here.
  discoveryUrls        String[]          @default([])
  /// Glob patterns that identify single product pages on the official domain.
  productUrlPatterns   String[]          @default([])
  /// Official promotions/offers pages (coupon extraction; first-party only).
  promoUrls            String[]          @default([])
  /// Official sale/deal listing pages: crawled with a link selector (depth 1) to reach discounted product pages.
  dealUrls             String[]          @default([])
  /// Explicit official product pages crawled every run (in addition to discovery).
  productUrls          String[]          @default([])
  /// Currency of the brand's US storefront prices; offers in other currencies are not stored.
  currency             String            @default("USD")
  enabled              Boolean           @default(true)
  priority             Int               @default(100)
  crawlFrequencyHours  Int               @default(24)
  /// Preferred crawl window start (hour 0–23 in `timezone`); null = any time. Staggers brands.
  crawlWindowStartHour Int?
  /// Window length in hours (1–24).
  crawlWindowHours     Int               @default(24)
  /// IANA timezone for the crawl window, e.g. "America/New_York".
  timezone             String            @default("America/New_York")
  /// Official store URL, when the brand runs one (shown in Admin; verified like any URL).
  officialStoreUrl     String?
  maxProductsPerRun    Int               @default(20)
  robotsStatus         String?
  robotsCheckedAt      DateTime?
  lastCrawlAt          DateTime?
  nextCrawlAt          DateTime?
  crawlStatus          String?
  consecutiveFailures  Int               @default(0)
  lastError            String?
  notes                String?
  /// Official logo (lib/commerce/brand-logos.ts). The URL is linked, never re-hosted. Shown only when logoStatus = VERIFIED.
  logoUrl              String?
  /// "official-jsonld" | "official-icon" | "wikidata-commons" | "admin-url" (admin override, see logoLocked).
  logoSource           String?
  /// The page or item the logo was read from (official home page, Wikidata item, or the admin's pasted URL).
  logoSourceUrl        String?
  /// Licence short name for Wikimedia Commons files (e.g. "Public domain", "CC BY-SA 4.0"); null for official-site logos.
  logoLicense          String?
  logoWidth            Int?
  logoHeight           Int?
  logoMime             String?
  logoCheckedAt        DateTime?
  logoVerifiedAt       DateTime?
  /// "VERIFIED" | "NOT_FOUND" | "FAILED" | "REJECTED"; null = never checked.
  logoStatus           String?
  logoReason           String?
  /// Admin-chosen logo: the brand-logos job never overwrites a locked brand.
  logoLocked           Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  runs                 CommerceRun[]
  products             CommerceProduct[]
  coupons              CommerceCoupon[]

  @@index([enabled, nextCrawlAt])
  @@index([logoStatus, logoCheckedAt])
  @@map("commerce_brands")
}

/// A non-brand source (a retailer, or a third-party coupon site kept disabled until its terms allow crawling).
model CommerceSource {
  id                  String        @id @default(cuid())
  name                String
  slug                String        @unique
  kind                String
  domain              String
  startUrls           String[]      @default([])
  urlPatterns         String[]      @default([])
  enabled             Boolean       @default(false)
  termsStatus         String        @default("UNREVIEWED")
  robotsStatus        String?
  robotsCheckedAt     DateTime?
  crawlFrequencyHours Int           @default(24)
  lastCrawlAt         DateTime?
  nextCrawlAt         DateTime?
  crawlStatus         String?
  consecutiveFailures Int           @default(0)
  lastError           String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  runs                CommerceRun[]

  @@map("commerce_sources")
}

/// One Apify run (or a skipped/blocked attempt) of the commerce engine.
model CommerceRun {
  id             String              @id @default(cuid())
  /// PRODUCT | COUPON
  purpose        String
  brandId        String?
  sourceId       String?
  actorId        String
  apifyRunId     String?             @unique
  datasetId      String?
  trigger        String
  status         String
  startUrls      Int                 @default(0)
  pagesProcessed Int?
  extracted      Int?
  accepted       Int?
  rejected       Int?
  errors         Json?
  usageUsd       Float?
  /// Apify compute units used by the run (stats.computeUnits), when reported.
  computeUnits   Float?
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  collectedAt    DateTime?
  brand          CommerceBrand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  source         CommerceSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  raws           CommerceRawRecord[]

  @@index([status, startedAt])
  @@index([brandId, startedAt])
  @@map("commerce_runs")
}

/// Exactly what Apify extracted for one page. Never modified; re-processing reads it again.
model CommerceRawRecord {
  id          String      @id @default(cuid())
  runId       String
  url         String
  purpose     String
  payload     Json
  contentHash String
  fetchedAt   DateTime    @default(now())
  run         CommerceRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, url])
  @@index([url])
  @@map("commerce_raw_records")
}

/// A normalized product read from an official or retailer page.
model CommerceProduct {
  id              String          @id @default(cuid())
  brandId         String?
  /// The Made4Buyers product it is attached to, only after an exact identity match.
  productEntityId String?
  canonicalUrl    String          @unique
  name            String
  model           String?
  mpn             String?
  sku             String?
  gtin            String?
  category        String?
  data            Json?
  identityStatus  String          @default("UNMATCHED")
  identityReason  String?
  lastRawId       String?
  observedAt      DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  brand           CommerceBrand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  offers          CommerceOffer[]

  @@index([productEntityId])
  @@index([brandId])
  @@map("commerce_products")
}

/// A price/availability observation at one seller page. Shown only while fresh.
model CommerceOffer {
  id                String          @id @default(cuid())
  productId         String
  seller            String
  /// MANUFACTURER | RETAILER
  sellerType        String
  destinationUrl    String
  /// Set only when a real affiliate provider generated it; null otherwise.
  affiliateUrl      String?
  affiliateProvider String?
  affiliateStatus   String          @default("NONE")
  price             Float?
  listPrice         Float?
  currency          String?
  availability      String?
  shipping          String?
  observedAt        DateTime
  sourceRawId       String?
  status            String          @default("FRESH")
  /// Destination check: UNCHECKED | OK | REDIRECTED_SAME_SITE | BROKEN | OFF_SITE | BLOCKED | UNREACHABLE.
  linkStatus        String          @default("UNCHECKED")
  linkCheckedAt     DateTime?
  linkHttpStatus    Int?
  linkFinalUrl      String?
  /// Persisted result of lib/commerce/deal-status.ts: ACTIVE | VERIFIED | EXPIRED | INVALID | BROKEN | CONFLICTING | UNVERIFIED.
  dealStatus        String?
  dealStatusReasons Json?
  dealStatusAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  product           CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, destinationUrl])
  @@index([status, observedAt])
  @@index([dealStatus])
  @@map("commerce_offers")
}

/// A promo code from a brand's own official promotions page (first-party) or a reviewed source.
model CommerceCoupon {
  id                   String         @id @default(cuid())
  brandId              String?
  merchant             String
  code                 String
  title                String?
  description          String?
  discount             String?
  discountType         String?
  startsAt             DateTime?
  expiresAt            DateTime?
  eligibility          String?
  restrictions         String?
  sourceUrl            String
  merchantUrl          String?
  /// VERIFIED | UNVERIFIED | EXPIRED | INVALID | CONFLICTING | UNKNOWN
  status               String         @default("UNVERIFIED")
  verificationEvidence String?
  firstSeenAt          DateTime       @default(now())
  observedAt           DateTime
  lastVerifiedAt       DateTime?
  sourceRawId          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  brand                CommerceBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@unique([merchant, code, sourceUrl])
  @@index([status, expiresAt])
  @@map("commerce_coupons")
}

/// Every identity decision: why a scraped product was (or was not) attached to a Made4Buyers product.
model CommerceMatchLog {
  id                String   @id @default(cuid())
  commerceProductId String
  productEntityId   String?
  result            String
  basis             String?
  reason            String
  createdAt         DateTime @default(now())

  @@index([commerceProductId])
  @@index([result, createdAt])
  @@map("commerce_match_logs")
}

/// Every verification check the commerce engine performs (link, official page, coupon, price, identity),
/// with its result — including checks that changed nothing. AuditLog keeps only changes.
model CommerceVerificationEvent {
  id         String   @id @default(cuid())
  /// offer | coupon | product
  entityType String
  entityId   String
  /// LINK | OFFICIAL | COUPON | PRICE | IDENTITY | DEAL_STATUS
  kind       String
  /// e.g. OK, BROKEN, VERIFIED, MISMATCH, ACTIVE, EXPIRED …
  result     String
  reason     String?
  sourceUrl  String?
  details    Json?
  checkedAt  DateTime @default(now())

  @@index([entityType, entityId, checkedAt])
  @@index([kind, checkedAt])
  @@map("commerce_verification_events")
}
