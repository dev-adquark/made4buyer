# ───────────────────────────────────────────────────────────────────────────────
# Made4Buyers — RealTech Review Engine
# Copy to .env.local (development) or set in Vercel → Settings → Environment Variables.
# REQUIRED = the app refuses to work correctly without it.
# Optional variables are only needed when their feature is enabled; when missing, the
# feature reports BLOCKED_BY_ENVIRONMENT / NOT_AVAILABLE_IN_ENVIRONMENT (never fake data).
# ───────────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED) ────────────────────────────────────────────────────────────
# Supabase: transaction pooler for the app, session pooler for migrations (both IPv4).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SITE_URL="https://www.example.com"      # canonical public origin, no trailing slash

# ── Admin (REQUIRED for /admin) ────────────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""                                   # long, unique password
ADMIN_SESSION_SECRET=""                             # ≥ 32 random characters (openssl rand -base64 48)
ADMIN_SESSION_HOURS="8"                             # optional, session lifetime (1–72)

# ── Cron (REQUIRED for scheduled jobs; Vercel Cron sends `Authorization: Bearer $CRON_SECRET`) ──
CRON_SECRET=""

# ── Content API (REQUIRED for ingestion) ───────────────────────────────────────
CONTENT_API_URL=""                                  # e.g. https://content.example.com/v1/reviews
CONTENT_API_KEY=""
CONTENT_API_AUTH_HEADER="Authorization"             # optional; e.g. "X-API-Key" to send the raw key
CONTENT_API_AUTH_SCHEME="Bearer"                    # optional; used when the header is Authorization
CONTENT_API_SOURCE_NAME=""                          # optional stable source id (defaults to API host)
CONTENT_API_TIMEOUT_MS="15000"                      # optional
CONTENT_API_MAX_RETRIES="3"                         # ignored: one request per page, never retried (lib/ops/api-guard.ts)
CONTENT_API_MAX_PAGES="5"                           # optional, follows `next` links on the same origin
CONTENT_API_SCHEMA_VERSION="1"                      # optional; contract major version the feed must declare (if it declares one)
CONTENT_API_IMAGES_LICENSED="false"                 # set true ONLY if every Content API image is licensed for this site
INGEST_MAX_ITEMS_PER_RUN="50"                       # optional, items processed per run (rest continue next run)
INGEST_CONCURRENCY="4"                              # optional
AUTO_PUBLISH_ENABLED="true"                         # publish QA-passing reviews automatically (pause in Admin → Automation)

# ── Apify Web Scraper: genuine editorial reviews (REQUIRED for review ingestion) ──
# Sources are configured in Admin → Sources (only those are crawled; robots.txt respected).
APIFY_API_TOKEN=""                                  # server-side only (Apify → Settings → Integrations)
APIFY_ACTOR_ID="apify/web-scraper"                  # optional
APIFY_RUN_TIMEOUT_SECS="1800"                       # optional, per run
APIFY_MEMORY_MB="2048"                              # optional, per run (cost)
APIFY_MAX_ITEMS_PER_COLLECT="100"                   # optional, dataset items ingested per run
COMMERCE_MONTHLY_BUDGET_USD="30"                    # Apify spend cap for the commerce engine; jobs pause at the cap until the next UTC month
COMMERCE_BRANDS_PER_RUN="6"                         # brands started per discovery pass (hourly)
COMMERCE_APIFY_ACTOR_ID="moJRLRc85AitArpNN"         # apify/web-scraper
COMMERCE_OFFER_RECHECK_HOURS="20"                   # re-crawl an offer page once its price is this old (public prices must stay ≤48 h)
DEALS_WEEKLY_DAY="0"                                # weekly full deals refresh: weekday (0 = Sunday, UTC); Admin can change it
DEALS_WEEKLY_HOUR_UTC="6"                           # weekly full deals refresh: hour (UTC)
COMMERCE_WEEKLY_BRANDS_PER_INVOCATION="8"           # brands started per weekly-refresh invocation (resumes on the next)
COMMERCE_WEEKLY_INVOCATION_BUDGET_MS="240000"       # time budget per invocation (Vercel limit 300 s)
COMMERCE_WEEKLY_SETTLE_HOURS="3"                    # how long a sweep waits for its own Apify runs

# ── Feedico coupon feed (optional; lib/commerce/feedico.ts) ────────────────────
# Affiliate-network promo codes for our brands via POST https://api.feedico.io/api/v1/catalog/coupons.
# Current codes are public, labelled "Via Feedico" (a code verified on the brand's own page shows as the
# official one). Server-side only — never NEXT_PUBLIC_. Verify: npx tsx scripts/verify-feedico.ts
FEEDICO_API_KEY=""                                  # fdco_… token from Feedico dashboard → Account (Production only)
FEEDICO_MONTHLY_REQUEST_BUDGET="600"                # optional; requests/UTC month the sync may use (Free plan: 1,000)
FEEDICO_MIN_REFETCH_HOURS="12"                      # optional; a re-run skips brands fetched this recently (job runs weekly, Friday 11:30 IST = 06:00 UTC)
FEEDICO_MAX_CATALOG_PAGES="15"                      # optional; catalogue pages (200 codes each, all merchants) per weekly sync, plus one request per registry brand
FEEDICO_MAX_FEED_AGE_DAYS="14"                      # optional (max 14); codes Feedico has not confirmed within this many days are rejected/deactivated

# ── AI-assisted buying guides (optional) ──────────────────────────────────────
# Keyword-to-Blog writes guides with an AI model. They are labelled "AI-assisted buying guide",
# never presented as reviews, and require editor approval before publishing.
KEYWORD_TO_BLOG_API_URL=""                          # e.g. https://…/v1/generate
KEYWORD_TO_BLOG_API_KEY=""
# Optional fallback key: used only when the primary key is refused (limit reached, auth, outage).
KEYWORD_TO_BLOG_API_KEY_SECONDARY=""
KEYWORD_TO_BLOG_TIMEOUT_MS="270000"                 # verified-factuality generations can take minutes
KEYWORD_TO_BLOG_MAX_WORDS="1200"
GUIDE_AUTOGEN_ENABLED="false"                       # true: daily job drafts original guides for newly reviewed products (editor approval still required)
# Stale-content detection (detect-stale job): flag reviews whose source article is older than N months, and guides older than M months.
STALE_REVIEW_MONTHS=18
STALE_GUIDE_MONTHS=12
KEYWORD_TO_BLOG_DAILY_LIMIT="3"                     # requests/day the auto job may use (your plan's quota)                    # keep under your plan's words/request cap
KEYWORD_ITEMS_PER_SLOT="1"                          # posts per publishing slot (morning/evening), 1–3: the controlled batch
BUSINESS_TIMEZONE="Asia/Kolkata"                    # IANA zone for slot days/hours and keyword frequencies (times stored in UTC)

# ── Commerce display & affiliate provider ──────────────────────────────────────
# Prices and seller links come from the commerce engine (official brand and retailer pages).
PRODUCT_PRICE_MAX_AGE_HOURS="48"                    # a price is shown only while observed within this many hours
AFFILIATE_PROVIDER="none"                           # none | amazon | skimlinks | impact, or a comma list tried in order (docs/OWNER_ACTIONS.md)
AMAZON_ASSOCIATES_TAG=""                            # amazon: your US Associates tracking ID, e.g. yourid-20 (only amazon.com URLs with an ASIN are wrapped)
SKIMLINKS_PUBLISHER_ID=""                           # skimlinks: numeric publisher ID (Publisher Hub)
SKIMLINKS_SITE_ID=""                                # skimlinks: numeric site/domain ID (Publisher Hub)
SKIMLINKS_CLIENT_ID=""                              # skimlinks: Merchant API client id (Hub → Toolbox → API)
SKIMLINKS_CLIENT_SECRET=""                          # skimlinks: Merchant API client secret
IMPACT_ACCOUNT_SID=""                               # impact: partner Account SID (Settings → API)
IMPACT_AUTH_TOKEN=""                                # impact: partner Auth Token
IMPACT_PROGRAMS=""                                  # impact: JSON {"merchant-domain.com":"<programId>"} for approved programs only

# ── Outbound link verification (optional tuning, lib/pipeline/verify-link.ts) ──────────────────────────────
LINK_VERIFY_TIMEOUT_MS="8000"
LINK_VERIFY_MAX_REDIRECTS="8"
LINK_VERIFY_INTERVAL_HOURS="24"
LINK_VERIFY_BATCH_SIZE="100"

# ── Image enrichment (optional) ────────────────────────────────────────────────
PEXELS_API_KEY=""                                   # Pexels API key; used before IMAGE_ENRICHMENT_URL when set
IMAGE_ENRICHMENT_URL=""                             # GET ?q=&brand=&category= → {url, license, attribution, licenseVerified}
IMAGE_ENRICHMENT_API_KEY=""
IMAGE_CDN_URL_TEMPLATE=""                           # e.g. https://cdn.example.com/fetch/{url}
IMAGE_REQUIRE_LICENSE="true"                        # withhold unverified-license images from public pages
IMAGE_INTEGRITY_PER_RUN="80"                        # image-integrity job: hero images re-checked per run (400 ms apart)

# ── Taxonomy / QA thresholds (optional) ────────────────────────────────────────
TAXONOMY_AUTO_ACCEPT_THRESHOLD="0.8"
ENTITY_LOW_CONFIDENCE_THRESHOLD="0.6"

# ── Google Search Console (optional; required only for indexing figures) ───────
GSC_SITE_URL=""                                     # exact property, e.g. sc-domain:example.com or https://www.example.com/
GSC_SERVICE_ACCOUNT_JSON=""                         # full service-account JSON on one line
GSC_INSPECTIONS_PER_RUN="50"
GSC_SITEMAP_URL=""                                  # optional; defaults to $NEXT_PUBLIC_SITE_URL/sitemap.xml
GOOGLE_SITE_VERIFICATION=""                         # optional; content value of Search Console's HTML-tag verification (public)

# ── Analytics (optional) ───────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""                    # Google Analytics 4 measurement id (G-XXXXXXX); public, loads gtag.js after the page is interactive
NEXT_PUBLIC_ANALYTICS_ID=""                         # external analytics id, only if intentionally enabled
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=""                 # https script URL of the external provider
NEXT_PUBLIC_ANALYTICS_HOST=""                       # its script/connect origin, added to the CSP
ANALYTICS_MIN_IMPRESSIONS="100"                     # CTR is INSUFFICIENT_DATA below this many deal impressions
METRIC_MIN_SAMPLE="10"                              # success metrics report INSUFFICIENT_DATA below this denominator

# ── Public site (optional) ──────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=""                        # shown on /contact; the page says so honestly when unset

# ── Sponsored placements (optional, OFF by default) ────────────────────────────
FEATURE_SPONSORED_PLACEMENTS="false"

# ── CSV import limits (optional) ───────────────────────────────────────────────
CSV_MAX_BYTES="1000000"
CSV_MAX_ROWS="5000"

# ── Logging (optional) ─────────────────────────────────────────────────────────
LOG_LEVEL="info"

# ── LOCAL DEVELOPMENT / TESTS ONLY — never set in production ───────────────────
# Lets the SSRF guard reach the local 127.0.0.1 SAMPLE stub server (npm run dev:stubs).
# Ignored when VERCEL_ENV=production.
UNSAFE_ALLOW_LOOPBACK_FOR_TESTS="false"
LOCAL_PG_PORT="54329"                               # port for `npm run db:local` if 54329 is taken
